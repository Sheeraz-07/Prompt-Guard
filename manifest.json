{
  "manifest_version": 3,
  "name": "PromptGuard: AI Prompt Sanitizer",
  "version": "1.0.0",
  "description": "Free, local-first Chrome side panel that removes API keys, secrets, credentials, and PII before you prompt AI.",
  "homepage_url": "https://github.com/Sheeraz-07/Prompt-Guard",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open PromptGuard Sanitizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
